<h2>All Projects</h2>


<% @projects.each do |project| %>
  <div>
    <h3><%= "<em>".html_safe unless project.active %><%= link_to project.name, project %><%= " (inactive)</em>".html_safe unless project.active %></h3>

    <%= project.description %>
    <h4>Tags: <%= project.tag_names %></h4>
  </div>

<% end %>
