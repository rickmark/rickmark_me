= form_for(@project) do |f|
  = render :partial => 'shared/error_area', :locals => { :object => @project }
  %fieldset.right_labels
    %ol
      %li
        = f.label :name
        = f.text_field :name
      %li
        = f.label :project_page
        = f.text_field :project_page
      %li
        = f.label :demo_url
        = f.text_field :demo_url
      %li
        = f.label :source_control_type
        = f.text_field :source_control_type
      %li
        = f.label :source_control_url
        = f.text_field :source_control_url
      %li
        = f.label :active
        = f.check_box :active
      %li
        = f.label :description
        = f.text_area :description
      %li
        = f.label :tag_names, "Tags"
        = f.text_field :tag_names
  = render :partial => 'shared/submit_area', :locals => { :form => f, :object => @project, :collection_path => projects_path }
