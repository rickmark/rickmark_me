!!!
%html( lang="en" )
  %head

    / Title
    %title Rick Mark - Software Artisan

    / Meta
    %meta( charset="utf-8" )
    %meta( name="viewport" content="width=device-width, initial-scale=1.0" )
    %meta( name="description" content="Rick Mark - Security Software Developer." )
    %meta( name="keywords" content="microsoft, ios, security, rails, ruby, developer, azure, cloud, mobile" )
    %meta( name="author" content="Rick Mark" )

    %link{ rel: 'shortcut icon', href: image_path('/images/favicon.png') }
    %link{ rel: 'apple-touch-icon', href: image_path('/images/apple-touch-icon.png') }
    %link{ rel: 'apple-touch-icon', sizes: '72x72', href: image_path('/images/apple-touch-icon-72x72.png') }
    %link{ rel: 'apple-touch-icon', sizes: '114x114', href: image_path('/images/apple-touch-icon-114x114.png') }

    /[if lt IE 9]
      %script( src="http://html5shim.googlecode.com/svn/trunk/html5.js" )


    / Retina Images
    :javascript
      if ((window.devicePixelRatio === undefined ? 1 : window.devicePixelRatio) > 1)
      document.cookie = 'HTTP_IS_RETINA=1;path=/';

    / Google Web Fonts
    = stylesheet_link_tag 'http://fonts.googleapis.com/css?family=Raleway:400,100,200,300,600,700,500'

    / Stylesheets
    = stylesheet_link_tag '/css/bootstrap.min.css'
    = stylesheet_link_tag '/css/animations.css'
    = stylesheet_link_tag '/css/font-awesome.min.css'
    = stylesheet_link_tag '/css/flaticon.css'
    = stylesheet_link_tag '/css/owl.carousel.css'
    = stylesheet_link_tag '/css/owl.theme.css'
    = stylesheet_link_tag '/css/style.css'
    = stylesheet_link_tag '/css/colors/blue.css', id: 'colors'

  %body
    / Facebook Source
    #fb-root
    :javascript
      (function (d, s, id) {
        var js, fjs = d.getElementsByTagName(s)[0];
        if (d.getElementById(id)) return;
        js = d.createElement(s);
        js.id = id;
        js.src = "//connect.facebook.net/en_US/all.js#xfbml=1";
        fjs.parentNode.insertBefore(js, fjs);
      }(document, 'script', 'facebook-jssdk'));

    = yield

    / Scripts
    = javascript_include_tag '/js/jquery-1.10.2.min.js'
    = javascript_include_tag '/js/page-loader.min.js'
    = javascript_include_tag '/js/bootstrap.min.js'
    = javascript_include_tag '/js/jquery.easing.js'
    = javascript_include_tag '/js/jquery.validate.min.js'
    = javascript_include_tag '/js/jquery.localscroll-1.2.7-min.js'
    = javascript_include_tag '/js/jquery.scrollTo-1.4.3.1-min.js'
    = javascript_include_tag '/js/jquery.fitvids.js'
    = javascript_include_tag '/js/jquery.appear.js'
    = javascript_include_tag '/js/waypoints.min.js'
    = javascript_include_tag '/js/owl.carousel.min.js'
    = javascript_include_tag 'https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false'

    / Custom Script
    = javascript_include_tag '/js/custom.js'
    = javascript_include_tag '/js/GoogleMap-dark.js'