
<h3>Active Projects</h3>
<ul>
  <% Project.active.order('updated_at DESC').limit(10).each do |project| %>
    <li><%= link_to(project.name, project) %></li>
  <% end %>
  <%= link_to("all projects...", projects_path) %>
</ul>

<h3>Most Recent Articles</h3>
<ul>
  <% Article.visible.order('updated_at DESC').limit(20).each do |article| %>
  <li><%= link_to(article.subject, article) %></li>
  <% end %>
  <%= link_to('all articles...', articles_path)%>
</ul>


<h3>Tags</h3>
<ul>
  <% Tag.all.each do |tag| %>
  <li><%= link_to(tag.name, tag) %></li>
  <% end %>
</ul>