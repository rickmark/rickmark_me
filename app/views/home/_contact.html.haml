/ Contact
%section#contact.black

  / Google Map
  #google-map.animated.zoom-out{ data: { latitude: @resume.info.latitude, longitude: @resume.info.longitude } }

  / Contact Content
  .content.contact-content.padded.dark.animated.slide-in-left
    %i.title-icon.text-primary.flaticon-speech43

    %h2 Do you want to contact me?
    / Contact List
    %ul.list-unstyled.list-unstyled-icons
      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-map-marker
        = @resume.info.location_name

      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-comment
        = link_to @resume.info.email_address, @resume.info.email_link

      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-phone
        = link_to @resume.info.phone_number, @resume.info.phone_link
    %br/
    %br/

    %p
      %a.btn.btn-primary{ href: @resume.info.print_url } Download my CV
    / Bottom Bar
    .bottom-bar.contact-bottom-bar
      .row
        .col-md-12.col-lg-6
          %h5
          = render partial: 'shared/social_links', object: @resume.info.social_links

        .col-md-12.col-lg-6
          / Like Button
          .fb-like{ data: { href: 'https://www.facebook.com/penwellr', layout: 'button_count', action: 'like', 'show-faces': 'false', share: 'false' } }

  / Contact Form
  = render partial: 'contact_form'

/ Contact / End