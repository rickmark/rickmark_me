/ Contact
%section#contact.black

  / Google Map
  #google-map.animated.zoom-out

  / Contact Content
  .content.contact-content.padded.dark.animated.slide-in-left
    %i.title-icon.text-primary.flaticon-speech43

    %h2 Do you want to contact me?
    / Contact List
    %ul.list-unstyled.list-unstyled-icons
      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-map-marker
        New York City, NY 10001

      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-comment
        = link_to 'info@rickmark.me', 'mailto:info@rickmark.me'

      %li
        %i.inline-icon.icon-before-and-after.text-primary.fa.fa-phone
        +1 (206) 913-3215
    %br/
    %br/

    %p
      <a href="https://onedrive.live.com/download?cid=CDF8B5CF78447AAD&resid=CDF8B5CF78447AAD%21144747&authkey=AGZ4JaCpJCFPLKc&em=2" class="btn btn-primary">Download
        my CV</a></p>
    / Bottom Bar
    .bottom-bar.contact-bottom-bar
      .row
        <div class="col-md-12 col-lg-6">
          %h5
          <!-- Social Icons -->
          <ul class="social-icons medium">
            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
            <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
          </ul>
        </div>
        <div class="col-md-12 col-lg-6">
          <h5>Like Me on Facebook!</h5>
          <!-- Like Button -->
          <div class="fb-like" data-href="https://www.facebook.com/penwellr" data-layout="button_count" data-action="like" data-show-faces="false" data-share="false"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Form -->
  <%= render 'contact_form' %>

</section>
<!-- Contact / End -->