!!!
%html{:lang => 'en'}
  %head
    / Title
    %title Rick Mark - Software Artisan
    / Meta
    %meta{:content => 'text/html; charset=UTF-8', 'http-equiv' => 'Content-Type'}/
    %meta{:content => 'public', 'http-equiv' => 'Cache-control'}/
    %meta{:content => 'width=device-width, initial-scale=1.0', :name => 'viewport'}/
    %meta{:content => 'Personal website of Rick Mark.  Software developer, business owner, and voracious reader.', :name => 'description'}/
    %meta{:content => '', :name => 'keywords'}/
    %meta{:content => 'Rick Mark', :name => 'author'}/

    %link{:href => 'images/favicon.png', :rel => 'shortcut icon'}/
    %link{:href => 'images/apple-touch-icon.png', :rel => 'apple-touch-icon'}/
    %link{:href => 'images/apple-touch-icon-72x72.png', :rel => 'apple-touch-icon', :sizes => '72x72'}/
    %link{:href => 'images/apple-touch-icon-114x114.png', :rel => 'apple-touch-icon', :sizes => '114x114'}/

    /[if lt IE 9]
      <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
    / Retina Images
    :javascript
      if((window.devicePixelRatio===undefined ? 1 : window.devicePixelRatio) > 1)
          document.cookie = 'HTTP_IS_RETINA=1;path=/';
    / End Retina Images
    / Google Web Fonts
    = stylesheet_link_tag 'http://fonts.googleapis.com/css?family=Raleway:400,100,200,300,600,700,500'
    / Stylesheets
    = stylesheet_link_tag :application
    = stylesheet_link_tag :blue, id: 'color'
  %body
    / Facebook Source
    #fb-root
    :javascript
      (function(d, s, id) {
        var js, fjs = d.getElementsByTagName(s)[0];
        if (d.getElementById(id)) return;
        js = d.createElement(s); js.id = id;
        js.src = "//connect.facebook.net/en_US/all.js#xfbml=1";
        fjs.parentNode.insertBefore(js, fjs);
      }(document, 'script', 'facebook-jssdk'));
    / Loader
    #page-loader
    / Loader / End
    / Header
    %header#nav-content.vertical-nav.nav-white
      / Logo
      .my-logo
        %a{:href => '#profile'}
          = image_tag 'my-photo.png', alt: 'Rick Mark'
      / Navigation
      %ul.menu.nav.me-nav
        %li.menu-item.active
          %a{:href => '#profile'}
            %span Profile
            %i.fa.fa-user
        %li.menu-item
          %a{:href => '#resume'}
            %span Resume
            %i.fa.fa-pencil
        %li.menu-item
          %a{:href => '#portfolio'}
            %span Portfolio
            %i.fa.fa-desktop
        %li.menu-item
          %a{:href => "#blog"}
            %span Latest Posts
            %i.fa.fa-comment
        %li.menu-item
          %a{:href => "#contact"}
            %span Contact
            %i.fa.fa-phone
      / Copyright
      %span.copyright.hidden-md
        © 2014
        = succeed '.' do
          %b Rick Mark
    / Header / End
    / Page Content
    #page-content
      / Profile
      %section#profile.black
        / Background photo
        -# profile-bg.editable-alpha{'data-alpha' => '40'}
          -# %img{:alt => "", :src => 'images/backgrounds/profile-bg.jpg'}/
        .content.padded.dark
          / Top Bar
          .top-bar
            / Social media
            .pull-left
              %span.hiddend-sm.hidden-xs Check my social media!    
              %ul.social-icons.si-pull-up
                %li
                  %a{:href => '#'}
                    %i.fa.fa-facebook
                %li
                  %a{:href => '#'}
                    %i.fa.fa-twitter
                %li
                  %a{:href => '#'}
                    %i.fa.fa-google-plus
            / URL
            .pull-right
              %a.hidden-xs{:href => 'http://www.rickmark.me'} www.rickmark.me
          / Profile Content
          .profile-content
            %h1.short Rick Mark
            %h5
              Professional Microsoft, Apple and Ruby software developer.
            %br
              I work to bring out the best in my team; I ask questions, and try to teach what I know to others. I lead
              with interpersonal skills backed by substantial knowledge and experience. I’m a realist, and at the same
              time I drive for high ideals. I estimate and re-estimate honestly and deliver.

            %a.btn.btn-default{:href => '#contact'} Contact me
          / Bottom Bar
          .bottom-bar.profile-bottom-bar.hidden-xs
            / Contact List
            %ul.list-inline
              %li
                %i.inline-icon.icon-before-and-after.text-primary.fa.fa-map-marker>
                8397 158th Ave NE #609, Redmond, WA 98052
              %li
                %i.inline-icon.icon-before-and-after.text-primary.fa.fa-comment
                %a{:href => 'mailto:info@rickmark.me'} info@rickmark.me
              %li
                %i.inline-icon.icon-before-and-after.text-primary.fa.fa-phone>
                +1 (617) 834-7876
      / Profile / End
