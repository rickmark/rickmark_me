#contact-form-holder.dark
  .contact-form-trigger.animated.slide-in-right.appear-second
    %i.flaticon-mail21
  = form_tag '/contact', role: 'form', id: 'contact-form' do
    .form-group
      = label_tag :name
      = text_field_tag :name, nil, class: 'form-control', placeholder: 'Enter your name', required: true
    .form-group
      = label_tag :email
      = text_field_tag :email, nil, class: 'form-control', placeholder: 'Enter your email', required: true
    .form-group
      = label_tag :message
      = text_area_tag :message, nil, class: 'form-control', rows: 3
    %button.btn.btn-default{ type: 'submit' }
      Submit
      %i.icon-after.fa.fa-chevron-right
