/ Header
%header#nav-content.vertical-nav.nav-white

  / Logo
  .my-logo
    %a( href="#profile" )
      = image_tag '/images/my-photo.png', alt: 'Rick Mark'

  / Navigation
  %ul.menu.nav.me-nav
    %li.menu-item.active
      %a( href="#profile" )
        %span Profile
        %i.fa.fa-user
    %li.menu-item
      %a( href="#resume" )
        %span Resume
        %i.fa.fa-pencil
    %li.menu-item
      %a( href="#portfolio" )
        %span Portfolio
        %i.fa.fa-desktop
    %li.menu-item
      %a( href="#blog" )
        %span Latest Posts
        %i.fa.fa-comment
    %li.menu-item
      %a( href="#contact" )
        %span Contact
        %i.fa.fa-phone

  / Copyright
  %span.copyright.hidden-md
    = surround "© #{ Time.now.year } ", '.' do
      %b= @resume.info.full_name