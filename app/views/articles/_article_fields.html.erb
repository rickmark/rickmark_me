<%= form_for(@article) do |form| %>
    <%= render :partial => 'shared/error_area', :locals => { :object => @article } %>
    <fieldset class="right_labels">
      <ol>
        <li>
          <%= form.label :subject %>
          <%= form.text_field :subject %>
        </li>
        <li>
          <%= form.label :body %>
          <%= form.text_area :body %>
        </li>
        <li>
          <%= form.label :hidden %>
          <%= form.check_box :hidden %>
        </li>
        <li>
          <%= form.label :tag_names, "Tags" %>
          <%= form.text_field :tag_names %>
        </li>
      </ol>
    </fieldset>
    <%= render :partial => 'shared/submit_area', :locals => { :form => form, :object => @article, :collection_path => articles_path } %>
<% end %>